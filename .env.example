# Optional for live maps in the local preview.
GEOAPIFY_ROUTING_KEY=
# Hosted owner inbox only. Do not add live Forms credentials to local test mode.
NETLIFY_FORMS_TOKEN=
NETLIFY_SITE_ID=
# Optional production namespace override for an existing deployment.
# Set only after verifying where its live records already reside.
RS_OWNER_STORE=
# Optional admin username alias. Both values stay in Functions, never browser code.
# The email must already belong to an invited Identity account with owner/staff access.
OWNER_LOGIN_USERNAME=
OWNER_LOGIN_EMAIL=

# Optional production email. Set these in Netlify's Functions environment.
# RS_MAIL_FROM must be a sender on a domain verified in Resend.
RESEND_API_KEY=
RS_MAIL_FROM=
RS_ALERT_EMAIL=
RS_QUOTE_EMAILS=false
RS_PICKUP_EMAILS=false

# Optional workspace chat. Use a dedicated Groq Free organization without billing.
# The bubble stays hidden without this key.
RS_ASSISTANT_GROQ_FREE_KEY=

# Optional Gmail account linking. Use the exact origin registered for this deployment.
# Local testing uses separate Google credentials and RS_GMAIL_ORIGIN=http://localhost:8888.
RS_GMAIL_ORIGIN=
RS_GMAIL_CLIENT_ID=
RS_GMAIL_CLIENT_SECRET=
# Generate 32 random bytes encoded as base64url. Use a different key per environment.
RS_GMAIL_TOKEN_KEY=
